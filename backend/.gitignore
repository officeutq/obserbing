/.bundle

# Keep local and deployed secrets out of Git. Commit only documented examples.
/.env*
!/.env.example
/config/master.key
/config/credentials/*.key

# Runtime output.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Generated dependencies and assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets
