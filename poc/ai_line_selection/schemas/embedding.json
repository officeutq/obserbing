{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obserbing://schemas/embedding/draft-1",
  "type": "object",
  "required": ["schema_version", "vectors"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "draft-1" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "values"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "values": {
            "type": "array",
            "minItems": 8,
            "items": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        }
      }
    }
  }
}
